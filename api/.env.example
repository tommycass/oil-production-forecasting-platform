API_KEY=<your-api-key>
RATE_LIMIT=requests/period

# Conexión al Data Warehouse (capa Gold). En local: Postgres de desarrollo.
# En cada EC2: el RDS correspondiente (oil_dw_staging / oil_dw_prod).
POSTGRES_HOST=<db-host>
POSTGRES_PORT=5432
POSTGRES_USER=oil
POSTGRES_PASSWORD=<db-password>
POSTGRES_DB=oil_dw

# --- Serving del modelo ML (ADR-035/037/038) ---
# Servidor MLflow del que la API carga los modelos Production. En la EC2 `api`, MLflow
# corre en la misma máquina (perfil `ml`): la API llega por red Docker interna.
# Sin setear, cae a http://localhost:5000 (ver app/services/model_loader.py).
# MLFLOW_TRACKING_URI=http://mlflow:5000
# Nombres de los modelos registrados por target (deben coincidir con el registry del
# Rol 1: config.experiment_name(target)). Por defecto ya apuntan a estos valores.
# MLFLOW_MODEL_NAME=produccion-forecast
# MLFLOW_MODEL_NAME_GAS=produccion-forecast-gas
# Cada cuánto (seg) la API revisa si hay una nueva versión Production para recargar.
# MODEL_POLL_INTERVAL_SECONDS=300
