# Plantilla de variables de entorno. Copiar a infra/.env con los valores de cada entorno.

# Conexión al Postgres del Data Warehouse.
# Local: container `postgres` (perfil local-db) con estos defaults.
# Staging y prod: instancia RDS; difieren únicamente en POSTGRES_DB.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=oil
POSTGRES_PASSWORD=oil
POSTGRES_DB=oil_dw

# Perfil para levantar el container Postgres en local.
# COMPOSE_PROFILES=local-db

# Metabase (BI, perfil bi). Metadata propia en una base separada del DW,
# que debe crearse una vez: CREATE DATABASE metabase_app;
# METABASE_DB_HOST: "postgres" en local, endpoint del RDS en staging y prod.
METABASE_DB_HOST=postgres
METABASE_DB_NAME=metabase_app
TZ=America/Argentina/Buenos_Aires
# METABASE_VERSION=v0.50.21   # versión fija para prod

# Rutas de los artefactos efímeros de dbt (logs/ y target/) fuera del repo.
# Evitan errores de permisos en EC2, donde el deploy hace git pull como root.
# target/ contiene el manifest.json que consume DataHub.
# DBT_LOG_PATH=/home/ubuntu/dbt-runtime/logs
# DBT_TARGET_PATH=/home/ubuntu/dbt-runtime/target

# ID de instancia EC2 para los dashboards de Grafana (solo en despliegue).
EC2_INSTANCE_ID=unknown
