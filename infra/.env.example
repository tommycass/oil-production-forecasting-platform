# Variables de interpolación de docker-compose (infra/). Copiar a infra/.env en
# cada máquina con los valores que correspondan a ese entorno.
#
# El Data Warehouse (Postgres) tiene DOS modos según el entorno:
#   - STAGING / local : se usa el container `postgres` del compose (perfil "local-db").
#   - PRODUCCIÓN      : se usa un Postgres gestionado en AWS (RDS); el container NO
#                       se levanta y las apps apuntan al endpoint de RDS.

# --- Perfil de compose ---
# Activa el container `postgres` local. Dejar en "local-db" en staging/local.
# En PRODUCCIÓN dejar vacío o no definir esta variable (para usar RDS, no el container).
COMPOSE_PROFILES=local-db

# --- Conexión al Data Warehouse (la consumen dbt y, a futuro, Metabase/DataHub) ---
# staging/local : host=localhost (desde el host) o host=postgres (entre containers).
# producción    : host=<endpoint de RDS> (ej. oil-dw.xxxx.us-east-2.rds.amazonaws.com).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=oil
POSTGRES_PASSWORD=oil
POSTGRES_DB=oil_dw

# ID de instancia EC2 para los dashboards de Grafana (solo en despliegue).
EC2_INSTANCE_ID=unknown
