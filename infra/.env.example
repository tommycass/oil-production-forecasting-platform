# Variables de interpolación de docker-compose (infra/).
# Copiar a infra/.env para sobrescribir los defaults. Si no existe, compose usa
# los valores por defecto definidos en docker-compose.yml (oil / oil / oil_dw).

# --- Data Warehouse (Postgres) ---
# En AWS estos valores apuntan al Postgres gestionado (ej. RDS).
POSTGRES_USER=oil
POSTGRES_PASSWORD=oil
POSTGRES_DB=oil_dw

# ID de instancia EC2 para los dashboards de Grafana (solo en despliegue).
EC2_INSTANCE_ID=unknown
