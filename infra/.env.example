# Variables de interpolación de docker-compose (infra/) y de conexión al DW.
# Copiar a infra/.env en cada máquina con los valores de ESE entorno.
#
# Data Warehouse: staging y producción usan un Postgres gestionado en AWS (RDS).
# Es UNA sola instancia RDS con DOS bases separadas para aislar las tablas dentro
# del free tier:
#     producción -> base  oil_dw_prod
#     staging    -> base  oil_dw_staging
# La ÚNICA diferencia entre el infra/.env de prod y el de staging es POSTGRES_DB.
#
# El container `postgres` del docker-compose queda SOLO para desarrollo local
# (perfil "local-db"); en staging y prod NO se levanta.

# --- Desarrollo LOCAL (laptop): descomentar para levantar el container Postgres ---
# COMPOSE_PROFILES=local-db

# --- Conexión al Data Warehouse (la consumen dbt y, a futuro, Metabase/DataHub) ---
# LOCAL  : host=localhost            db=oil_dw         user/pass=oil (defaults del container)
# STAGING: host=<endpoint del RDS>   db=oil_dw_staging user/pass del RDS
# PROD   : host=<endpoint del RDS>   db=oil_dw_prod    user/pass del RDS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=oil
POSTGRES_PASSWORD=oil
POSTGRES_DB=oil_dw

# --- (Opcional, recomendado en EC2 / checkout root-owned) Artefactos de dbt fuera del repo ---
# logs/ y target/ son efímeros (se regeneran). Escribirlos fuera del repo evita que el
# ownership del checkout (el deploy hace `git pull` como root) rompa dbt con
# PermissionError. Si se setean, dbt los usa; en local/CI dejarlos comentados (defaults
# del proyecto). Ojo: target/ tiene manifest.json (lo consumen dbt docs / state / lineage
# a DataHub) → si se relocaliza, esos consumidores deben usar el mismo path.
# DBT_LOG_PATH=/home/ubuntu/dbt-runtime/logs
# DBT_TARGET_PATH=/home/ubuntu/dbt-runtime/target

# ID de instancia EC2 para los dashboards de Grafana (solo en despliegue).
EC2_INSTANCE_ID=unknown
