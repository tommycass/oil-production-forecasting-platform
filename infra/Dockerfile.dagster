# Imagen de Dagster con UI (ADR-018, actualización jun-2026).
#
# Sirve el webserver + daemon de Dagster cargando el grafo de assets del pipeline
# (data_pipeline.orchestration.definitions): Bronze(parquet) → Bronze(Postgres) →
# Silver → Gold + Data Quality. Se levanta vía el perfil "orchestration" del
# docker-compose; no forma parte del stack por defecto ni del build de CI.
FROM python:3.11-slim

# git: por si `dbt deps` resuelve algún paquete vía git. psycopg2-binary trae su
# propia libpq, así que no hace falta build-essential.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/dagster/app
ENV PYTHONPATH=/opt/dagster/app

# Requirements primero (capa cacheable): deps del pipeline + del proyecto dbt.
COPY data_pipeline/requirements.txt /tmp/req-pipeline.txt
COPY transform/requirements.txt /tmp/req-transform.txt
RUN pip install --no-cache-dir -r /tmp/req-pipeline.txt -r /tmp/req-transform.txt

# Código del pipeline + proyecto dbt. PROJECT_ROOT (config.py) resuelve a este WORKDIR,
# así transform/ queda en /opt/dagster/app/transform como espera el DbtProject.
COPY data_pipeline/ ./data_pipeline/
COPY transform/ ./transform/

# Paquetes dbt (dbt_utils, dbt_expectations) resueltos en build.
RUN cd transform && dbt deps

# DAGSTER_HOME: historial de runs/logs (montado como volumen en el compose).
ENV DAGSTER_HOME=/opt/dagster/home
RUN mkdir -p "$DAGSTER_HOME"

EXPOSE 3000

# `dagster dev` levanta webserver + daemon. Por DAGSTER_IS_DEV_CLI regenera el
# manifest de dbt al arrancar (prepare_if_dev → dbt parse), de modo que los modelos
# Silver/Gold aparecen como assets sin pasos manuales.
CMD ["dagster", "dev", "-m", "data_pipeline.orchestration.definitions", "-h", "0.0.0.0", "-p", "3000"]
