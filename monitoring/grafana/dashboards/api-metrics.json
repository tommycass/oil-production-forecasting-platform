          "metricEditorMode": 0,
          "queryLanguage": "CWLI",
          "region": "default",
          "namespace": "AWS/EC2",
          "metricName": "CPUUtilization",
          "dimensions": {"InstanceId": "$instance"},
          "statistic": "Average",
