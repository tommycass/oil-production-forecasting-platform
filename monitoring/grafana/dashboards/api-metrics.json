      "type": "stat",
      "title": "EC2 CPU (Ahora)",
      "description": "CPU actual de la instancia EC2 seleccionada",
      "datasource": {"type": "cloudwatch", "uid": "aws-cloudwatch-final"},
      "pluginVersion": "12.4.2",
      "targets": [
